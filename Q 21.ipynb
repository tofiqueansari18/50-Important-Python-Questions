   "source": [
    "CALCULATE GCD GREATEST COMMON DIVISOR USING RECURSION"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "f3766346",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "gcd:  4\n"
     ]
    }
   ],
   "source": [
    "a = 5842265412\n",
    "b = 8545221452\n",
    "\n",
    "while b != 0:\n",
    "    a,b = b, a%b\n",
    "print(\"gcd: \", a)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "e9daa306",
   "metadata": {},
   "outputs": [],
   "source": [
    "def gcd(a,b):\n",
    "    if b == 0:\n",
    "        return a\n",
    "    return gcd(b, a%b)"
   ]
  },
